    "tools": [
      {
        "name": "get_church_profile",
        "title": "Get church profile",
        "description": "Return the profile of the church the signed-in treasurer belongs to: name, code, contacts, officers and financial year start.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_receipts",
        "title": "List receipts",
        "description": "List offering and tithe receipts for the signed-in treasurer's church within an optional date range (YYYY-MM-DD).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "description": "Inclusive start date, YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "description": "Inclusive end date, YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum rows to return (default 50, max 200)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_expenses",
        "title": "List expenses",
        "description": "List church expenses for the signed-in treasurer's church, newest first, with an optional date range.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "description": "Inclusive start date, YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "description": "Inclusive end date, YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum rows to return (default 50, max 200)."
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "cash_summary",
        "title": "Cash summary for a period",
        "description": "Summarise receipts and expenses for a date range, splitting each offering category into the conference share and the local church share (tithe 100% conference, combined offering and first fruit 50/50, all others 100% local).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "type": "string",
              "description": "Inclusive start date, YYYY-MM-DD."
            },
            "end_date": {
              "type": "string",
              "description": "Inclusive end date, YYYY-MM-DD."
            }
          },
          "required": [
            "start_date",
            "end_date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "create_receipt",
        "title": "Create receipt",
        "description": "Record a new offering/tithe receipt for the signed-in treasurer's church. The fund type (trust or local) and the conference/local split come from the offering category. Created as a draft pending approval.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Offering category name or code, e.g. 'Tithe', 'Combined Offering', 'First Fruit'."
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Receipt amount in the church's currency."
            },
            "receipt_number": {
              "type": "string",
              "minLength": 1,
              "description": "Receipt number. Omit to auto-generate the next number."
            },
            "date": {
              "type": "string",
              "description": "Transaction date, YYYY-MM-DD. Defaults to today."
            },
            "fund": {
              "type": "string",
              "enum": [
                "trust",
                "local"
              ],
              "description": "Optional expected fund type; used to disambiguate categories with the same name."
            },
            "member_name": {
              "type": "string",
              "description": "Name of the member/giver."
            },
            "payment_method": {
              "type": "string",
              "enum": [
                "cash",
                "mpesa",
                "bank_transfer",
                "cheque",
                "bank_deposit"
              ],
              "description": "Payment method (default cash)."
            },
            "description": {
              "type": "string",
              "description": "Optional note or description."
            }
          },
          "required": [
            "category",
            "amount"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
